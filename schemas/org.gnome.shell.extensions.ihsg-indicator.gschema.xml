<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.ihsg-indicator"
          path="/org/gnome/shell/extensions/ihsg-indicator/">
    <key name="symbols" type="as">
      <default>['^JKSE']</default>
      <summary>Daftar simbol Yahoo Finance</summary>
    </key>
    <key name="refresh-interval" type="u">
      <range min="15" max="3600"/>
      <default>60</default>
      <summary>Interval refresh data (detik)</summary>
    </key>
    <key name="rotate-interval" type="u">
      <range min="2" max="60"/>
      <default>4</default>
      <summary>Jeda pergantian emiten di top bar (detik)</summary>
    </key>
    <key name="show-change" type="b">
      <default>true</default>
      <summary>Tampilkan persentase perubahan di top bar</summary>
    </key>
    <key name="panel-position" type="s">
      <choices>
        <choice value='left'/>
        <choice value='center'/>
        <choice value='right'/>
      </choices>
      <default>'right'</default>
      <summary>Area panel: left, center, right</summary>
    </key>
    <key name="panel-offset" type="u">
      <range min="0" max="20"/>
      <default>0</default>
      <summary>Urutan di dalam area panel (0 = paling kiri di area itu)</summary>
    </key>
  </schema>
</schemalist>
