<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.ihsg-indicator"
          path="/org/gnome/shell/extensions/ihsg-indicator/">
    <key name="symbols" type="as">
      <default>['^JKSE']</default>
      <summary>Yahoo Finance symbols</summary>
    </key>
    <key name="refresh-interval" type="u">
      <range min="15" max="3600"/>
      <default>60</default>
      <summary>Data refresh interval in seconds</summary>
    </key>
    <key name="rotate-interval" type="u">
      <range min="2" max="60"/>
      <default>4</default>
      <summary>Top bar symbol rotation interval in seconds</summary>
    </key>
    <key name="up-color" type="s">
      <default>'#26a269'</default>
      <summary>Color for rising values</summary>
    </key>
    <key name="down-color" type="s">
      <default>'#e01b24'</default>
      <summary>Color for falling values</summary>
    </key>
    <key name="panel-position" type="s">
      <choices>
        <choice value='left'/>
        <choice value='center'/>
        <choice value='right'/>
      </choices>
      <default>'right'</default>
      <summary>Panel area: left, center, or right</summary>
    </key>
    <key name="panel-offset" type="u">
      <range min="0" max="20"/>
      <default>0</default>
      <summary>Order within the panel area (0 is the leftmost)</summary>
    </key>
  </schema>
</schemalist>
